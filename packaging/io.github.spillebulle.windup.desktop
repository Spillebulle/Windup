[Desktop Entry]
Type=Application
Name=Windup
GenericName=Clipboard history
Comment=Clipboard history at your cursor and plain-text paste, behind a hotkey
Exec=windup
Icon=io.github.spillebulle.windup
Terminal=false
Categories=Utility;
Keywords=clipboard;history;paste;plain;text;hotkey;
StartupNotify=true
StartupWMClass=io.github.spillebulle.windup
Actions=popup;paste-plain;
# KDE: lets Windup ask KWin for a still of the screen (the screenshot overlay).
# KWin matches the caller's executable path to this entry, so it does not
# apply to the AppImage, which falls back to the screenshot portal.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2

[Desktop Action popup]
Name=Open clipboard history
Exec=windup --popup

[Desktop Action paste-plain]
Name=Paste as plain text
Exec=windup --paste-plain
